LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=120
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT=15
SEARCH_MAX_RESULTS=5
PAGE_FETCH_PROVIDER=local
PAGE_FETCH_TIMEOUT=10
PAGE_FETCH_MAX_BYTES=500000
PAGE_CONTENT_MAX_CHARS=3000
PAGE_EXCERPT_MAX_CHARS=1000
PAGE_FETCH_MAX_PER_COMPETITOR=2
PAGE_FETCH_MAX_PER_RUN=10
PAGE_FETCH_RESPECT_ROBOTS=true

# Survey / Questionnaire module LLM config
SURVEY_LLM_PROVIDER=openai_compatible
SURVEY_LLM_API_KEY=
SURVEY_LLM_BASE_URL=https://api.openai.com/v1
SURVEY_LLM_MODEL=gpt-4o-mini
SURVEY_LLM_TEMPERATURE=0.3
SURVEY_LLM_TIMEOUT_SECONDS=60

# If SURVEY_LLM_* is left blank, the Survey module reuses LLM_PROVIDER,
# LLM_API_KEY, LLM_BASE_URL, and LLM_MODEL.
